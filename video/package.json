{
  "name": "market-terminal-video",
  "private": true,
  "description": "The README demo video for market-terminal, composed from VHS clips of the synthetic demo.",
  "scripts": {
    "clips": "cd .. && vhs docs/clips.tape",
    "studio": "remotion studio",
    "render": "node scripts/check-clip.mjs && remotion render Demo ../docs/img/demo.mp4 --crf=18",
    "gif": "ffmpeg -v error -y -i ../docs/img/demo.mp4 -vf \"fps=12,scale=1600:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=192:stats_mode=diff[p];[b][p]paletteuse=dither=none:diff_mode=rectangle\" ../docs/img/demo.gif",
    "lint": "tsc --noEmit",
    "check-clip": "node scripts/check-clip.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/cli": "4.0.546",
    "@remotion/fonts": "4.0.546",
    "@remotion/media": "4.0.546",
    "@remotion/transitions": "4.0.546",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.546"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
